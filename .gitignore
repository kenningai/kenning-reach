# Working research and build drafts — local only, never pushed to GitHub.
# Measurement dumps, vendor exports and scratch that has no business in a
# release surface — and may carry credentials pulled from a live system.
docs/research/

# The operator discipline and env template for deploy/ are product: the README
# and GETTING_STARTED depend on them, and the CLAUDE.md and .env.* rules above
# would otherwise catch both.
!deploy/CLAUDE.md
!deploy/.env.example

# The public build's scratch output and its local target path.
publish/.staging/
publish/.target
